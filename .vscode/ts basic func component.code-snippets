    "import { useQuery } from 'react-query'",
    "import { API } from 'aws-amplify'",
    "import * as queries from '@graphql/queries'",
    "",
    "$1",
    "async function $TM_FILENAME_BASE():Promise<QUERY_NAME> {",
    "  try {"
    "    const innerFunction = (await API.graphql({"
    "      query: queries.<QUERY_NAME>,"
    "        variables: {},"
    "    })) as {"
    "      data: <QUERY_NAME>"
    "    };"
    "      return innerFunction.data;"
    "  } catch (error) {"
    "     throw new Error(`error in query!!! ${JSON.stringify(error)}`);"
    "  }",
    "}",
    "$1"
    "export default function use${TM_FILENAME_BASE}() {",
